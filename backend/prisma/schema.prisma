generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id             Int                   @id @default(autoincrement())
  name           RoleName              @unique
  users          User[]
  employees      Employee[]
  roleHistories  EmployeeRoleHistory[]
}

model Branch {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  isActive           Boolean            @default(true)
  address            String?
  phone              String?
  name_am            String?
  branchType         BranchType         @default(INDEPENDENT)
  sourceBranchId     Int?
  sourceBranch       Branch?            @relation("BranchHierarchy", fields: [sourceBranchId], references: [id])
  dependentBranches  Branch[]           @relation("BranchHierarchy")
  closures           DailyClosure[]
  snapshots          DailySnapshot[]
  productions        ProductionRecord[]
  remainings         RemainingRecord[]
  users              User[]
  employees          Employee[]
  wastes             WasteRecord[]
  sourceTransfers    ProductTransfer[]  @relation("SourceTransfers")
  dependentTransfers ProductTransfer[]  @relation("DependentTransfers")

  @@index([isActive])
  @@index([sourceBranchId])
}

model Employee {
  id                    Int                   @id @default(autoincrement())
  employeeCode          String                @unique
  name                  String
  email                 String?
  phone                 String?
  status                EmployeeStatus        @default(ACTIVE)
  primaryRoleId         Int?
  primaryBranchId       Int?
  hireDate              DateTime?             @db.Date
  separationDate        DateTime?             @db.Date
  separationReason      String?
  userAccountCreatedAt  DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user                  User?
  primaryRole           Role?                 @relation(fields: [primaryRoleId], references: [id])
  primaryBranch         Branch?               @relation(fields: [primaryBranchId], references: [id])
  roleHistory           EmployeeRoleHistory[]
  productionsCreated    ProductionRecord[]    @relation("ProductionCreatedBy")
  productionsUpdated    ProductionRecord[]    @relation("ProductionUpdatedBy")
  remainingsCreated     RemainingRecord[]     @relation("RemainingCreatedBy")
  remainingsUpdated     RemainingRecord[]     @relation("RemainingUpdatedBy")
  wastes                WasteRecord[]         @relation("WasteCreatedBy")
  closuresClosed        DailyClosure[]        @relation("ClosureClosedBy")
  snapshotsClosed       DailySnapshot[]       @relation("SnapshotClosedBy")
  snapshotsInvalidated  DailySnapshot[]       @relation("SnapshotInvalidatedBy")
  productTransfers      ProductTransfer[]     @relation("ProductTransferCreator")
  reopenLogs            ReopenLog[]           @relation("ReopenReopenedBy")
  auditLogs             AuditLog[]

  @@index([status])
  @@index([primaryBranchId])
  @@index([primaryRoleId])
}

model EmployeeRoleHistory {
  id         Int       @id @default(autoincrement())
  employeeId Int
  roleId     Int
  startDate  DateTime  @default(now()) @db.Date
  endDate    DateTime? @db.Date

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
}

model User {
  id                   Int                @id @default(autoincrement())
  employeeId           Int                @unique
  name                 String
  username             String             @unique
  passwordHash         String
  roleId               Int
  branchId             Int?
  createdAt            DateTime           @default(now())
  isBlocked            Boolean            @default(false)
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  email                String?            @unique

  employee             Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch               Branch?            @relation(fields: [branchId], references: [id])
  role                 Role               @relation(fields: [roleId], references: [id])
  passwordResets       PasswordReset[]
  refreshTokens        RefreshToken[]

  @@index([employeeId])
  @@index([username])
  @@index([roleId])
  @@index([branchId])
  @@index([isActive])
  @@index([deletedAt])
}

model Product {
  id              Int                   @id @default(autoincrement())
  name            String                @unique
  price           Decimal               @db.Decimal(12, 2)
  isActive        Boolean               @default(true)
  category        ProductCategory
  unitType        UnitType
  costPrice       Decimal?              @db.Decimal(12, 2)
  name_am         String?
  sellingPrice    Decimal?              @db.Decimal(12, 2)
  productionShift ProductionShift       @default(BOTH)
  snapshotItems   DailySnapshotItem[]
  priceHistory    ProductPriceHistory[]
  productions     ProductionRecord[]
  remainings      RemainingRecord[]
  wastes          WasteRecord[]
  productTransfers ProductTransfer[]

  @@index([category])
  @@index([isActive])
}

model ProductPriceHistory {
  id        Int       @id @default(autoincrement())
  productId Int
  price     Decimal   @db.Decimal(12, 2)
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime  @default(now())
  product   Product   @relation(fields: [productId], references: [id])

  @@index([productId, validFrom])
  @@index([productId, validTo])
  @@index([productId, validFrom, validTo])
}

model ProductionRecord {
  id              Int       @id @default(autoincrement())
  productId       Int
  quantity        Decimal   @db.Decimal(12, 3)
  branchId        Int
  shift           Shift
  createdAt       DateTime  @default(now())
  createdBy       Int
  operationalDate DateTime  @db.Date
  productionDate  DateTime
  updatedAt       DateTime  @updatedAt
  updatedBy       Int?

  branch          Branch    @relation(fields: [branchId], references: [id])
  creator         Employee  @relation("ProductionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  product         Product   @relation(fields: [productId], references: [id])
  updater         Employee? @relation("ProductionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([branchId, operationalDate, productId])
  @@index([branchId, operationalDate])
  @@index([productId])
  @@index([productId, operationalDate])
  @@index([shift])
  @@index([createdBy])
  @@index([operationalDate])
  @@index([branchId, operationalDate, productId, shift])
}

model RemainingRecord {
  id              Int             @id @default(autoincrement())
  productId       Int
  quantity        Decimal         @db.Decimal(12, 3)
  branchId        Int
  createdAt       DateTime        @default(now())
  createdBy       Int
  operationalDate DateTime        @db.Date
  status          RemainingStatus @default(FINAL)
  updatedAt       DateTime        @updatedAt
  updatedBy       Int?
  autoFinalizedAt DateTime?

  branch          Branch          @relation(fields: [branchId], references: [id])
  creator         Employee        @relation("RemainingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  product         Product         @relation(fields: [productId], references: [id])
  updater         Employee?       @relation("RemainingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([branchId, operationalDate, productId])
  @@index([branchId, operationalDate, productId])
  @@index([branchId, operationalDate])
  @@index([productId])
  @@index([createdBy])
  @@index([status])
  @@index([branchId, operationalDate, productId, status])
}

model WasteRecord {
  id              Int       @id @default(autoincrement())
  productId       Int
  branchId        Int
  operationalDate DateTime  @db.Date
  quantity        Decimal   @db.Decimal(12, 3)
  reason          String?
  createdBy       Int
  createdAt       DateTime  @default(now())

  branch          Branch    @relation(fields: [branchId], references: [id])
  creator         Employee  @relation("WasteCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  product         Product   @relation(fields: [productId], references: [id])

  @@index([branchId, operationalDate, productId])
  @@index([branchId, operationalDate])
  @@index([productId])
  @@index([createdBy])
}

model DailyClosure {
  id              Int            @id @default(autoincrement())
  branchId        Int
  operationalDate DateTime       @db.Date
  isClosed        Boolean        @default(false)
  closedBy        Int?
  closedAt        DateTime?
  note            String?
  closureType     ClosureType    @default(MANUAL)
  autoCloseAt     DateTime?
  reopenedAt      DateTime?

  branch          Branch         @relation(fields: [branchId], references: [id])
  closedByUser    Employee?      @relation("ClosureClosedBy", fields: [closedBy], references: [id], onDelete: SetNull)
  snapshot        DailySnapshot?
  reopenLogs      ReopenLog[]

  @@unique([branchId, operationalDate])
  @@index([branchId])
  @@index([isClosed])
  @@index([autoCloseAt])
}

model DailySnapshot {
  id                Int                 @id @default(autoincrement())
  closureId         Int                 @unique
  branchId          Int
  operationalDate   DateTime            @db.Date
  closedBy          Int?
  closedAt          DateTime?
  isInvalidated     Boolean             @default(false)
  invalidatedAt     DateTime?
  invalidatedBy     Int?
  createdAt         DateTime            @default(now())

  branch            Branch              @relation(fields: [branchId], references: [id])
  closedByUser      Employee?           @relation("SnapshotClosedBy", fields: [closedBy], references: [id], onDelete: SetNull)
  closure           DailyClosure        @relation(fields: [closureId], references: [id])
  invalidatedByUser Employee?           @relation("SnapshotInvalidatedBy", fields: [invalidatedBy], references: [id], onDelete: SetNull)
  items             DailySnapshotItem[]

  @@index([branchId])
  @@index([isInvalidated])
  @@index([operationalDate])
}

model DailySnapshotItem {
  id               Int           @id @default(autoincrement())
  snapshotId       Int
  productId        Int
  openingStock     Decimal       @default(0) @db.Decimal(12, 3)
  dayProduction    Decimal       @default(0) @db.Decimal(12, 3)
  nightProduction  Decimal       @default(0) @db.Decimal(12, 3)
  sellableStock    Decimal       @default(0) @db.Decimal(12, 3)
  remainingStock   Decimal       @default(0) @db.Decimal(12, 3)
  wasteQuantity    Decimal       @default(0) @db.Decimal(12, 3)
  estimatedSold    Decimal       @default(0) @db.Decimal(12, 3)
  estimatedRevenue Decimal       @default(0) @db.Decimal(12, 2)
  snapshotPrice    Decimal?      @db.Decimal(12, 2)
  receivedTransfer Decimal       @default(0) @db.Decimal(12, 3)
  sentTransfer     Decimal       @default(0) @db.Decimal(12, 3)
  product          Product       @relation(fields: [productId], references: [id])
  snapshot         DailySnapshot @relation(fields: [snapshotId], references: [id])

  @@unique([snapshotId, productId])
  @@index([productId])
}

model ProductTransfer {
  id                Int           @id @default(autoincrement())
  productId         Int
  sourceBranchId    Int
  dependentBranchId Int?
  operationalDate   DateTime      @db.Date
  receivedQuantity  Decimal       @default(0) @db.Decimal(12, 3)
  sentQuantity      Decimal?      @db.Decimal(12, 3)
  returnedQuantity  Decimal       @default(0) @db.Decimal(12, 3)
  createdBy         Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  product           Product       @relation(fields: [productId], references: [id])
  sourceBranch      Branch        @relation("SourceTransfers", fields: [sourceBranchId], references: [id])
  dependentBranch   Branch?       @relation("DependentTransfers", fields: [dependentBranchId], references: [id])
  creator           Employee?     @relation("ProductTransferCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([sourceBranchId, operationalDate])
  @@index([dependentBranchId, operationalDate])
  @@index([operationalDate])
}

model ReopenLog {
  id              Int          @id @default(autoincrement())
  branchId        Int
  operationalDate DateTime     @db.Date
  reopenedBy      Int
  reopenedAt      DateTime     @default(now())
  reason          String?

  closure         DailyClosure @relation(fields: [branchId, operationalDate], references: [branchId, operationalDate])
  user            Employee     @relation("ReopenReopenedBy", fields: [reopenedBy], references: [id], onDelete: Restrict)

  @@index([branchId, operationalDate])
  @@index([reopenedBy])
  @@index([reopenedAt])
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  entityType String
  entityId   Int
  action     String
  oldValue   Json?
  newValue   Json?
  employeeId Int?
  actorName  String    @default("System")
  createdAt  DateTime  @default(now())

  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([employeeId])
  @@index([createdAt])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model RolloverCache {
  key         String   @id
  processedAt DateTime
  updatedAt   DateTime @updatedAt
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum RoleName {
  ADMIN
  MANAGER
  BAKER
  CAKE_CHEF
  COOKIE_BAKER
  FETIR_CHEF
  CASHIER
  TRANSFER_OPERATOR
}

enum Shift {
  DAY
  NIGHT
}

enum ProductCategory {
  BREAD_AND_SWEET_BREADS
  CREAM_CAKES
  SOFT_CAKES
  DRY_CAKES
  DRINKS_AND_RETAIL_ITEMS
  FETIRE_AND_SNACKS
  COOKIES
}

enum ProductionShift {
  DAY
  NIGHT
  BOTH
}

enum UnitType {
  piece
  kg
}

enum RemainingStatus {
  DRAFT
  FINAL
}

enum BranchType {
  SOURCE
  DEPENDENT
  INDEPENDENT
}

enum ClosureType {
  MANUAL
  AUTO_FINALIZE
}
