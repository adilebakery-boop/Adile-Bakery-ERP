# Generate using:
#   openssl rand -hex 64
JWT_SECRET=your-64-byte-hex-secret-here

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/bakery"

# How long JWT tokens remain valid (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# Frontend origin (used for CORS)
FRONTEND_URL=http://localhost:5173

# Backend port
PORT=3000

# Email credentials for notifications (if applicable)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
